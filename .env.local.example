# Google Gemini API Key for PepTalk Clinical Intelligence
# In Vercel, add this under Project Settings -> Environment Variables
# Locally, copy this file to .env.local and add your key:
GEMINI_API_KEY=

# ClinicLivingPlus Access Authentication
# Restricts access strictly to @cliniclivingplus.com staff
CLINIC_PASSWORD=ClinicLivingPlus2026!
SESSION_SECRET=cliniclivingplus-secure-peptalk-session-key-2026

# Administrator Security Key (to access the Admin Portal & Roster Management)
ADMIN_SECRET=ClinicLivingAdmin2026!

# Gmail SMTP Email Dispatch (Direct, zero-DNS email delivery from your Gmail account)
# Create a 16-character App Password at https://myaccount.google.com/apppasswords
SMTP_USER=cliniclivingplus.ai@gmail.com
SMTP_PASS=

# Optional Resend Integration (Alternative email provider)
RESEND_API_KEY=
EMAIL_FROM=ClinicLivingPlus Security <onboarding@resend.dev>
